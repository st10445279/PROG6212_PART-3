@model ApprovalViewModel
@{
    ViewData["Title"] = "Review Claim";
}

<div class="card">
    <div class="card-header">
        <h2><i class="fas fa-clipboard-check"></i> Review Claim #@Model.ClaimId</h2>
    </div>

    <div class="details-grid">
        <div class="detail-item">
            <strong>Lecturer:</strong>
            <span>@Model.LecturerName</span>
        </div>
        <div class="detail-item">
            <strong>Email:</strong>
            <span>@Model.LecturerEmail</span>
        </div>
        <div class="detail-item">
            <strong>Hours Worked:</strong>
            <span>@Model.HoursWorked</span>
        </div>
        <div class="detail-item">
            <strong>Hourly Rate:</strong>
            <span>@Model.HourlyRate.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <strong>Total Amount:</strong>
            <span class="total-amount">@Model.TotalAmount.ToString("N2")</span>
        </div>
        <div class="detail-item">
            <strong>Submitted Date:</strong>
            <span>@Model.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="detail-item full-width">
                <strong>Additional Notes:</strong>
                <p>@Model.Notes</p>
            </div>
        }
    </div>

    @if (Model.Documents.Any())
    {
        <h3>Supporting Documents</h3>
        <div class="documents-list">
            @foreach (var doc in Model.Documents)
            {
                <div class="document-item">
                    <i class="fas fa-file"></i>
                    <span>@doc.FileName</span>
                    <a asp-action="DownloadDocument" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-info">
                        <i class="fas fa-download"></i> Download
                    </a>
                </div>
            }
        </div>
    }

    <div class="approval-actions">
        <form asp-action="ApproveClaim" asp-route-id="@Model.ClaimId" method="post" style="display:inline;">
            <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to approve this claim?');">
                <i class="fas fa-check"></i> Approve Claim
            </button>
        </form>

        <button type="button" class="btn btn-danger" onclick="showRejectModal()">
            <i class="fas fa-times"></i> Reject Claim
        </button>

        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div id="rejectModal" class="modal">
    <div class="modal-content">
        <h3>Reject Claim</h3>
        <form asp-action="RejectClaim" asp-route-id="@Model.ClaimId" method="post">
            <div class="form-group">
                <label>Rejection Reason:</label>
                <textarea name="rejectionReason" class="form-control" rows="4" required></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                <button type="button" class="btn btn-secondary" onclick="closeRejectModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/modal.js"></script>
}
