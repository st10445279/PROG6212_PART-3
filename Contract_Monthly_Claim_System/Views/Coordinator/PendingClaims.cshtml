@model List<Claim>
@{
    ViewData["Title"] = "Pending Claims";
}

<div class="card">
    <h2><i class="fas fa-clock"></i> All Pending Claims</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Hours</th>
                        <th>Rate</th>
                        <th>Total Amount</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>#@claim.ClaimId</td>
                            <td>@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                            <td>@claim.HoursWorked</td>
                            <td>@claim.HourlyRate.ToString("N2")</td>
                            <td>@claim.TotalAmount.ToString("N2")</td>
                            <td>@claim.SubmittedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <a asp-action="ReviewClaim" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-primary">
                                    <i class="fas fa-search"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="no-data">No pending claims.</p>
    }
</div>
