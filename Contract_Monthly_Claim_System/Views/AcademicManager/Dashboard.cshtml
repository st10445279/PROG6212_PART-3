@model List<Claim>
@{
    ViewData["Title"] = "Academic Manager Dashboard";
}

<div class="dashboard-header">
    <h1><i class="fas fa-user-tie"></i> Academic Manager Dashboard</h1>
    <p class="subtitle">Welcome, @ViewBag.UserName</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <i class="fas fa-clock stat-icon pending"></i>
        <div>
            <h3>@ViewBag.TotalPending</h3>
            <p>Pending Claims</p>
        </div>
    </div>
    <div class="stat-card">
        <i class="fas fa-dollar-sign stat-icon"></i>
        <div>
            <h3>@ViewBag.TotalPendingAmount.ToString("N2")</h3>
            <p>Total Pending Amount</p>
        </div>
    </div>
</div>

<div class="card">
    <h2>Pending Claims for Final Approval</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Hours</th>
                        <th>Rate</th>
                        <th>Total Amount</th>
                        <th>Submitted</th>
                        <th>Documents</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>#@claim.ClaimId</td>
                            <td>@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                            <td>@claim.HoursWorked</td>
                            <td>@claim.HourlyRate.ToString("N2")</td>
                            <td>@claim.TotalAmount.ToString("N2")</td>
                            <td>@claim.SubmittedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge badge-info">@claim.Documents.Count files</span>
                            </td>
                            <td>
                                <a asp-action="ReviewClaim" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-primary">
                                    <i class="fas fa-search"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="no-data">No pending claims for approval.</p>
    }
</div>
