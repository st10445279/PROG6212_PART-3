@model List<Claim>
@{
    ViewData["Title"] = "All Claims";
}

<div class="card">
    <h2><i class="fas fa-list"></i> All Claims</h2>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Hours</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>#@claim.ClaimId</td>
                            <td>@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                            <td>@claim.HoursWorked</td>
                            <td>@claim.TotalAmount.ToString("N2")</td>
                            <td><span class="badge badge-@claim.Status.ToLower()">@claim.Status</span></td>
                            <td>@claim.SubmittedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <a asp-action="ClaimDetails" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="no-data">No claims found.</p>
    }
</div>
