@model List<Claim>
@{
    ViewData["Title"] = "Approved Claims";
}

<div class="card">
    <div class="card-header">
        <h2><i class="fas fa-check-double"></i> All Approved Claims</h2>
        <div class="header-actions">
            <a asp-action="ExportToExcel" class="btn btn-success btn-sm">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
            <a asp-action="ExportToPdf" class="btn btn-danger btn-sm">
                <i class="fas fa-file-pdf"></i> Export PDF
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer</th>
                        <th>Email</th>
                        <th>Hours</th>
                        <th>Total Amount</th>
                        <th>Approved Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>#@claim.ClaimId</td>
                            <td>@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                            <td>@claim.Lecturer?.Email</td>
                            <td>@claim.HoursWorked</td>
                            <td>@claim.TotalAmount.ToString("N2")</td>
                            <td>@claim.ApprovedDate?.ToString("yyyy-MM-dd")</td>
                            <td>
                                <a asp-action="ClaimDetails" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="4"><strong>Total:</strong></td>
                        <td><strong>@($"R{Model.Sum(c => c.TotalAmount).ToString("N2")}")</strong></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <p class="no-data">No approved claims.</p>
    }
</div>
